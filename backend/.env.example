PORT=8000
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=emios_secure_password
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Relational persistence layer (assessments/uploads/waves). Primary/production target is
# PostgreSQL via asyncpg. Note the port: docker-compose.yml maps the postgres container's
# 5432 to HOST port 5433 (5432 is a common local-Postgres-install collision) - use 5433
# here when running via docker-compose.yml, plain 5432 only if you're pointing at some
# other local Postgres install. For local dev without Docker/Podman at all, point this at
# SQLite instead:
#   DATABASE_URL=sqlite+aiosqlite:///./emios_dev.db
DATABASE_URL=postgresql+asyncpg://emios:emios_secure_password@localhost:5433/emios

# Auth (JWT). Has a dev default in app/core/config.py, but any real deployment
# MUST override this - anyone with the default value can forge valid tokens for
# any user. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=emios-dev-secret-change-me-in-production

# "production" makes the auth cookie Secure (HTTPS-only) - set this in any real
# deployment. Stays "development" for local HTTP work against localhost.
ENVIRONMENT=development
# Only matters for a frontend served from a different origin than this API -
# both real deployment paths (Vite dev proxy, prod same-origin) are same-origin
# already. JSON array syntax, per pydantic-settings' default list parsing.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# "production" makes the auth cookie Secure (HTTPS-only) - set this in any real
# deployment. Stays "development" for local HTTP work against localhost.
ENVIRONMENT=development
# Only matters for a frontend served from a different origin than this API -
# both real deployment paths (Vite dev proxy, prod same-origin) are same-origin
# already. JSON array syntax, per pydantic-settings' default list parsing.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# LLM Configuration - all optional fallbacks behind AWS Bedrock (below), which is this
# project's preferred/primary provider. Without ANY of these configured, the app still
# runs fully via deterministic fallbacks (agents produce structured, non-AI narrative
# text instead of LLM-generated text) - useful for infra-free local dev, just not the
# real experience.
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
# OR Azure OpenAI:
AZURE_OPENAI_API_KEY=your_azure_api_key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-05-01-preview
# Model IDs are configurable, not hardcoded - override any of these to swap models:
# OPENAI_MODEL=gpt-4o
# GEMINI_MODEL=gemini-1.5-flash
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# AWS Bedrock (preferred LLM + embeddings provider - see app/core/llm_provider.py).
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are for local/dev only - a real deployment
# should attach an IAM role to the instance instead and leave these two blank.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Listed != invokable - Bedrock's catalog lists far more models than an account actually
# has entitlement to invoke. Verify what your account can actually call (via converse())
# before assuming a model ID here works; some models also need a cross-region inference
# profile ID (a "us." prefix) instead of the bare model ID. qwen.qwen3-coder-next is the
# current default (fast, no formatting post-processing needed) - swap freely.
BEDROCK_LLM_MODEL_ID=qwen.qwen3-coder-next
# 4096 covers the pipeline agents' narrative responses plus the Document Discovery
# extractor's JSON output - lower it back down if you're on a model/account with tight
# per-request token limits and don't need the extractor to handle large documents.
BEDROCK_MAX_TOKENS=4096

# Langfuse Observability (self-hosted or cloud - https://langfuse.com). Optional - the
# app runs fine with ENABLE_LANGFUSE_TRACING=false and no keys at all, it just won't emit
# traces. NOTE: the setting is LANGFUSE_HOST, not LANGFUSE_BASE_URL - that name has
# already caused a silent misconfiguration once (traces looked "off" when they were
# actually just pointed nowhere). Get real keys from your own Langfuse project's
# Settings > API Keys - never commit real keys here, this file is checked into git.
ENABLE_LANGFUSE_TRACING=false
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_HOST=http://localhost:3000
