# Copy this file to backend/.env.production on the deployment host and fill in real
# values. docker-compose.prod.yml reads it for both the postgres/neo4j containers'
# credentials and the backend container's runtime config.
#
# NOTE: NEO4J_URI/DATABASE_URL are NOT set here - docker-compose.prod.yml hardcodes them
# to the in-network service hostnames (bolt://neo4j:7687, postgres:5432) since that
# topology is fixed by the compose file, not something to reconfigure per-deploy.

PORT=8000

POSTGRES_USER=emios
POSTGRES_PASSWORD=change_me_before_deploying
POSTGRES_DB=emios

NEO4J_PASSWORD=change_me_before_deploying

# Auth (JWT). REQUIRED - the app falls back to a public, source-controlled dev
# secret if this is left unset, which lets anyone forge valid tokens for any user.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_me_before_deploying

# Optional - only needed if you want live LLM-backed agent reasoning instead of the
# deterministic fallback. Leave blank to run without either.
OPENAI_API_KEY=
GEMINI_API_KEY=

# AWS Bedrock (preferred LLM + embeddings provider) + S3 (document storage). Prefer
# attaching an IAM role to the instance instead of setting AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY here - leave both blank when using a role.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_LLM_MODEL_ID=nvidia.nemotron-nano-12b-v2
BEDROCK_MAX_TOKENS=512
S3_BUCKET_NAME=emios-documents

# Langfuse tracing needs its own self-hosted server; leave disabled unless you're
# actually standing one up for the demo.
ENABLE_LANGFUSE_TRACING=false
